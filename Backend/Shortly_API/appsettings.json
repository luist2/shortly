{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Token": "SECRET_KEY",
    "Issuer": "Shortly.API",
    "Audience": "Shortly.Client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "RefreshTokenRotationHours": 24,
    "RefreshTokenPepper": "SECRET_REFRESH_TOKEN_PEPPER",
    "MaxActiveSessions": 3
  },
  "CookieSettings": {
    "RefreshTokenCookieName": "refreshToken"
  },
  "GeneralSettings": {
    "BaseDomain": "https://localhost:7161",
    "FrontendBaseUrl": "http://localhost:4200",
    "DefaultRole": "User"
  },
  "ApiSettings": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "Pagination": {
      "DefaultPageSize": 10,
      "MaxPageSize": 50
    },
    "RateLimiting": {
      "UrlCreation": {
        "AuthenticatedPermitLimit": 100,
        "AnonymousPermitLimit": 20
      },
      "GlobalPermitLimit": 60,
      "GlobalWindowMinutes": 1,
      "AuthPermitLimit": 5,
      "AuthWindowMinutes": 1
    },
    "UrlSettings": {
      "AnonymousExpirationHours": 24
    },
    "ShortCode": {
      "AnonymousLength": 8,
      "AuthenticatedLength": 8,
      "GenerationMaxRetries": 5
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_HOST;Port=5432;Database=YOUR_DATABASE;Username=YOUR_USER;Password=YOUR_PASSWORD"
  }
}
